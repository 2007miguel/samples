{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "create_checkout",
        "description": "Creates a new checkout session with initial items. Returns the full checkout object.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "checkout": {
              "type": "object",
              "description": "The initial checkout object.",
              "properties": {
                "line_items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "The product ID."
                          }
                        },
                        "required": [
                          "id"
                        ]
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ]
                  }
                },
                "currency": {
                  "type": "string",
                  "description": "The ISO 4217 currency code (e.g., 'USD')."
                }
              },
              "required": [
                "line_items",
                "currency"
              ]
            }
          },
          "required": [
            "checkout"
          ]
        }
      },
      {
        "name": "get_checkout",
        "description": "Retrieves the current state of a checkout session by its ID.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The unique ID of the checkout session."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "update_checkout",
        "description": "Updates an existing checkout session.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The unique ID of the checkout session."
            },
            "checkout": {
              "type": "object",
              "description": "A checkout object containing the fields to update."
            }
          },
          "required": [
            "id",
            "checkout"
          ]
        }
      },
      {
        "name": "complete_checkout",
        "description": "Completes a checkout session by processing the payment.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The unique ID of the checkout session."
            },
            "payment_data": {
              "type": "object",
              "description": "The encrypted payment instrument and details."
            },
            "ap2": {
              "type": "object",
              "description": "Agent Payment Protocol (AP2) artifacts, such as the checkout mandate.",
              "properties": {
                "checkout_mandate": {
                  "type": "string",
                  "description": "The SD-JWT checkout mandate and key binding."
                }
              }
            },
            "risk_signals": {
              "type": "object",
              "description": "Optional risk signals from the client."
            }
          },
          "required": [
            "id",
            "payment_data"
          ]
        }
      },
      {
        "name": "cancel_checkout",
        "description": "Cancels an in-progress checkout session.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The unique ID of the checkout session."
            }
          },
          "required": [
            "id"
          ]
        }
      }
    ]
  }
}